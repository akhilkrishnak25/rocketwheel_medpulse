{
  "name": "medipath-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Hospital Doctor Appointment Booking Platform",
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start",
    "seed": "npm --prefix backend run seed",
    "db:push": "npm --prefix backend run prisma:push",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
