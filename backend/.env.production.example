# Copy this file to backend/.env.production and replace every placeholder.
# Do not commit backend/.env.production.
NODE_ENV=production
PORT=5000

POSTGRES_USER=medipulse_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=medipulse_db
DATABASE_URL=postgresql://medipulse_admin:replace-with-a-long-random-password@postgres:5432/medipulse_db?schema=public

JWT_SECRET=replace-with-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=https://your-frontend-domain.example
BASE_URL=https://your-backend-domain.example
PLATFORM_FEE=20

# Keep payments disabled until Razorpay is integrated.
PAYMENT_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Free email OTP through Gmail SMTP, Brevo SMTP, or another SMTP provider.
# Set OTP_MODE=smtp only after filling all SMTP values.
OTP_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-dedicated-email@example.com
SMTP_PASS=your-email-app-password
OTP_FROM=your-dedicated-email@example.com