// Prisma Schema for MediPulse Multi-Hospital Platform
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Staff user (Super Admin, Hospital Admin, Doctor)
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          String         // SUPER_ADMIN, HOSPITAL_ADMIN, DOCTOR
  name          String
  phone         String?
  isActive      Boolean        @default(true)
  status        String         @default("ACTIVE") // ACTIVE, PENDING, REJECTED, SUSPENDED, INVITED
  lastLoginAt   DateTime?
  hospitalAdmin HospitalAdmin?
  doctor        Doctor?
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Hospital {
  id                  String          @id @default(uuid())
  name                String
  slug                String          @unique
  code                String          @unique // e.g. APOL-HYD
  status              String          @default("ACTIVE") // PENDING, APPROVED, ACTIVE, REJECTED, INACTIVE
  website             String?
  logoUrl             String?
  imageUrl            String?
  address             String
  city                String
  state               String
  pincode             String
  phone               String
  email               String
  emergencyContact    String
  openingHours        String          // e.g. "24/7" or "08:00 AM - 08:00 PM"
  about               String
  facilities          String          // JSON array or comma separated
  rating              Float           @default(4.5)
  isEmergencyAvailable Boolean        @default(true)
  departments         Department[]
  doctors             Doctor[]
  appointments        Appointment[]
  hospitalAdmins      HospitalAdmin[]
  notifications       Notification[]
  reviews             Review[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model HospitalAdmin {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  roleTitle   String    @default("Hospital Administrator")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Department {
  id          String        @id @default(uuid())
  hospitalId  String
  hospital    Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  code        String        // e.g. CARD, ORTHO
  description String?
  icon        String?       // Lucide icon name
  doctors     Doctor[]
  appointments Appointment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([hospitalId, slug])
}

model Doctor {
  id                  String           @id @default(uuid())
  userId              String?          @unique
  user                User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospitalId          String
  hospital            Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name                String
  photoUrl            String?
  qualification       String           // e.g. MBBS, MD (Cardiology)
  specialization      String           // e.g. Interventional Cardiologist
  experienceYears     Int              @default(5)
  consultationFee     Float            @default(500)
  languages           String           // e.g. "English, Hindi, Telugu"
  about               String
  workingDays         String           // e.g. "Mon,Tue,Wed,Thu,Fri,Sat"
  workingHoursStart   String           @default("09:00")
  workingHoursEnd     String           @default("17:00")
  slotDurationMinutes Int              @default(30)
  breakStart          String?          @default("13:00")
  breakEnd            String?          @default("14:00")
  isActive            Boolean          @default(true)
  status              String           @default("ACTIVE") // PENDING, APPROVED, ACTIVE, REJECTED, SUSPENDED
  schedules           DoctorSchedule[]
  leaves              DoctorLeave[]
  appointments        Appointment[]
  slots               AppointmentSlot[]
  reviews             Review[]
  prescriptions       Prescription[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model DoctorSchedule {
  id                  String   @id @default(uuid())
  doctorId            String
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime           String   // "09:00"
  endTime             String   // "17:00"
  slotDurationMinutes Int      @default(30)
  isAvailable         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([doctorId, dayOfWeek])
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id               String          @id @default(uuid())
  fullName         String
  mobileNumber     String
  email            String
  dateOfBirth      String?         // YYYY-MM-DD
  gender           String?         // Male, Female, Other
  address          String?
  bloodGroup       String?         // A+, B+, O+, AB+, etc.
  emergencyContact String?
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([mobileNumber])
  @@index([email])
}

model Appointment {
  id                 String           @id @default(uuid())
  appointmentNumber  String           @unique // e.g. APT-2026-0001
  hospitalId         String
  hospital           Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctorId           String
  doctor             Doctor           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  departmentId       String
  department         Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  appointmentDate    String           // YYYY-MM-DD
  timeSlot           String           // e.g. "10:30 AM" or "10:30"
  tokenNumber        Int              // e.g. 4 (4th token for that doctor on that date)
  status             String           @default("PENDING_PAYMENT") 
  // PENDING_PAYMENT, CONFIRMED, WAITING, IN_CONSULTATION, COMPLETED, CANCELLED, NO_SHOW
  consultationFee    Float
  platformFee        Float            @default(20)
  totalAmount        Float
  cancellationReason String?
  notes              String?
  payment            Payment?
  digitalOp          DigitalOP?
  prescription       Prescription?
  medicalRecord      MedicalRecord?
  appointmentSlot    AppointmentSlot?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([hospitalId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([patientId])
}

model AppointmentSlot {
  id            String       @id @default(uuid())
  doctorId      String
  doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date          String       // YYYY-MM-DD
  startTime     String       // "10:30"
  endTime       String       // "11:00"
  isBooked      Boolean      @default(false)
  isLocked      Boolean      @default(false)
  lockedUntil   DateTime?
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([doctorId, date, startTime])
}

model Payment {
  id                 String       @id @default(uuid())
  appointmentId      String       @unique
  appointment        Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  razorpayOrderId    String       @unique
  razorpayPaymentId  String?      @unique
  razorpaySignature  String?
  amount             Float
  currency           String       @default("INR")
  status             String       @default("PENDING") 
  // PENDING, SUCCESS, FAILED, REFUNDED, CANCELLED
  paymentMethod      String?      // UPI, Card, Netbanking
  failureReason      String?
  idempotencyKey     String       @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model DigitalOP {
  id            String      @id @default(uuid())
  opNumber      String      @unique // e.g. OP-2026-0926-000123
  secureToken   String      @unique // cryptographically secure random token for public/QR verification
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  generatedAt   DateTime    @default(now())
  pdfUrl        String?
  qrData        String      // URL or verification string
  isVerified    Boolean     @default(false)
  verifiedAt    DateTime?
  downloadCount Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Notification {
  id            String    @id @default(uuid())
  hospitalId    String
  hospital      Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  recipientType String    // HOSPITAL_ADMIN, DOCTOR, PATIENT
  recipientId   String?   // User id or Doctor id
  title         String
  message       String
  type          String    // NEW_APPOINTMENT, PAYMENT_SUCCESS, APPOINTMENT_CANCELLED, SYSTEM
  isRead        Boolean   @default(false)
  readAt        DateTime?
  metadata      String?   // JSON string with extra details (OP number, amounts, etc.)
  createdAt     DateTime  @default(now())
}

model Prescription {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  diagnosis     String
  medicines     String      // JSON array of { name, dosage, frequency, duration, instructions }
  instructions  String?
  followUpDate  String?     // YYYY-MM-DD
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model MedicalRecord {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptoms      String?
  vitals        String?     // JSON of { bp, pulse, temperature, weight, spo2 }
  clinicalNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Review {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientName String
  rating      Int      @default(5)
  comment     String?
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "LOGIN", "CANCEL_APPOINTMENT", "UPDATE_SCHEDULE"
  entity    String   // "Appointment", "Doctor", "Payment"
  entityId  String?
  details   String?  // JSON string
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model OtpVerification {
  id           String   @id @default(uuid())
  mobileNumber String
  appointmentId String?
  otpCode      String
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([mobileNumber, otpCode])
}

model AccountToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  type      String   // ACTIVATION, PASSWORD_RESET
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token, type])
  @@index([email])
}

